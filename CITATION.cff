    given-names: Janhavi
version: 1.0.0
license: MIT
date-released: 2026-10-22
repository-code: "https://github.com/janhavi-giri/wafer-map-tda"
url: "https://github.com/janhavi-giri/wafer-map-tda"
keywords:
  - topological data analysis
  - persistent homology
  - Mapper
  - wafer map
  - semiconductor
  - defect classification
